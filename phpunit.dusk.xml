<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración de pruebas E2E con Laravel Dusk (Selenium/ChromeDriver).

  IMPORTANTE: estas pruebas corren contra SQLite en archivo (database/dusk.sqlite),
  NUNCA contra la base de datos real de Supabase definida en .env.

  Flujo de ejecución:
    1. La clase base Tests\Browser\E2eTestCase levanta automáticamente
       "php artisan serve" en 127.0.0.1:8299 heredando estas variables de entorno.
    2. ChromeDriver se levanta automáticamente en el puerto 9515 (DuskTestCase::prepare).
  Ejecución: php artisan dusk
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>

    <php>
        <!-- force="true": estos valores DEBEN ganar sobre cualquier variable DB_*/APP_*
             definida en la sesión del desarrollador. Sin force, una DB_CONNECTION=pgsql
             del shell haría que migrate:fresh corrija sobre la BD REAL. -->
        <env name="E2E_SEED" value="1" force="true"/>
        <env name="APP_ENV" value="dusk" force="true"/>
        <env name="APP_URL" value="http://127.0.0.1:8299" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <!-- Base de datos dedicada (archivo): no tocar Supabase ni la suite regular -->
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value="E:/laragon/www/sitema_gestion_academico/database/dusk.sqlite" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_HOST" value="" force="true"/>
        <env name="DB_PORT" value="" force="true"/>
        <!-- La sesión DEBE ser file/persistente para que el navegador mantenga login -->
        <env name="SESSION_DRIVER" value="file" force="true"/>
        <env name="CACHE_STORE" value="file" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="APP_DEBUG" value="true" force="true"/>
    </php>
</phpunit>
